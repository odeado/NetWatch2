# Base de datos y datos en runtime (contienen datos de empleados: nombres, correos, telefonos, fotos)
webapp/netwatch.db
webapp/netwatch.db-journal
webapp/static/uploads/

# Archivos de importacion con datos personales/de la empresa
*.xlsx
*.xls
scanner/results/

# Credenciales de Firebase (email/password del usuario de Auth) -- nunca a git
webapp/firebase_config.json
scanner/firebase_config.json

# Credenciales de la cuenta admin local compartida usada para el apagado
# remoto viejo via SMB (ver webapp/apagado_remoto.py) -- nunca a git
webapp/apagado_config.json

# Credenciales de la cuenta Firebase dedicada al agente de apagado/reinicio
# que corre en cada PC (ver agente_apagado/README_agente.md) -- nunca a git
agente_apagado/agente_config.json
agente_apagado/netwatch_agente.log
agente_apagado/agente_token_cache.json
agente_apagado/**/agente_config.json
agente_apagado/**/netwatch_agente.log
agente_apagado/**/agente_token_cache.json

# Contiene el token real de la API de WhatsApp Business y el numero de
# destinatario -- nunca a git (ver "alertas" adentro). Si necesitas la
# estructura para otro sitio, copia este archivo y borra esos 3 valores.
scanner/config.json

# Python
__pycache__/
*.pyc
.venv/
venv/

# Sistema
.DS_Store
Thumbs.db

# Instalador de Python bundleado para sucursales sin Python -- ~28MB, se
# distribuye aparte (no tiene sentido en el historial de git).
scanner/python-3.8.10-amd64.exe

# Estado local del puente de toasts a la pantalla chica (ver tools/toast_pantalla1.py)
tools/toast_pantalla1_estado.json

# Logs en runtime -- cambian en cada ejecucion, no aportan nada al historial
scanner/monitor_error.log
webapp/monitor.log
webapp/web_error.log
webapp/web_stdout.log
*.log

# Backups puntuales de la base de datos -- mismo motivo que netwatch.db
# (datos de empleados), se generan localmente antes de cambios grandes
webapp/netwatch_backup_*.db

# Config local de Claude Code en esta PC (permisos, no hay nada sensible,
# pero es config de la maquina, no del proyecto -- no tiene sentido en git)
.claude/
